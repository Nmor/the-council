// VS Code settings template — Council guidance for Claude Code and Codex.
// Apply by merging into the platform's User/settings.json:
//   macOS:   ~/Library/Application Support/Code/User/settings.json
//   Linux:   ~/.config/Code/User/settings.json
//   Windows: %APPDATA%\Code\User\settings.json
//   WSL2:    ~/.vscode-server/data/Machine/settings.json (remote profile)
//
// Council references below are relative to the source or installed resources root.
//
// References:
// - rules-library/common/extreme-lint-policy.md (format-on-save mandatory)
// - rules-library/common/install-allowlist.md (no autoUpdate; allowlist publishers)
// - rules-library/common/no-discards.md (lint diagnostics surface on hover)
// - rules-library/common/secrets-management.md (workspace trust mandatory)
{
  // ============================================================
  // Security & workspace trust (per install-allowlist.md)
  // ============================================================
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "prompt",
  "security.workspace.trust.emptyWindow": false,
  "security.workspace.trust.startupPrompt": "always",

  // ============================================================
  // Extension governance (per install-allowlist.md)
  // ============================================================
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": false, // Manual review before update
  "extensions.ignoreRecommendations": false,

  // ============================================================
  // Git safety (per plan-completion-before-push.md + git-workflow.md)
  // ============================================================
  "git.allowNoVerifyCommit": false,
  "git.allowForcePush": false,
  "git.confirmSync": true,
  "git.enableCommitSigning": true,
  "git.suggestSmartCommit": false,

  // ============================================================
  // Telemetry (privacy)
  // ============================================================
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,

  // ============================================================
  // Task safety (per install-allowlist.md)
  // ============================================================
  "task.allowAutomaticTasks": "off",

  // ============================================================
  // Editor — format on save (per extreme-lint-policy.md)
  // ============================================================
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.organizeImports": "always"
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "editor.rulers": [80, 100], // matches MD013 line-length floor

  // ============================================================
  // Per-language defaults
  // ============================================================
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[swift]": {
    "editor.defaultFormatter": "sswg.swift-lang",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[kotlin]": {
    "editor.defaultFormatter": "fwcd.kotlin",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[solidity]": {
    "editor.defaultFormatter": "JuanBlanco.solidity",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "[sql]": {
    "editor.defaultFormatter": "dorzey.vscode-sqlfluff",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // ============================================================
  // TypeScript / JavaScript strictness (per extreme-lint-policy.md)
  // ============================================================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.completeFunctionCalls": true,
  "eslint.run": "onType",
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.codeActionsOnSave.rules": null,

  // Tailwind CSS — recognise class-name composition helpers
  // (clsx, cva, cx — common React patterns)
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)",  "(?:'|\"|`)([^']*)(?:'|\"|`)"],
    ["clsx\\(([^)]*)\\)","(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],

  // ============================================================
  // Python strictness
  // ============================================================
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoImportCompletions": true,
  "ruff.lint.select": ["ALL"],

  // ============================================================
  // Go strictness
  // ============================================================
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "go.lintFlags": ["--allow-parallel-runners"],
  "go.vetOnSave": "workspace",
  "go.formatTool": "goimports",
  "go.useLanguageServer": true,
  "go.testFlags": ["-v", "-race", "-cover"],
  "go.testTimeout": "30s",
  "go.coverOnSave": false,
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "staticcheck": true,
    "gofumpt": true,
    "analyses": {
      "unusedparams": true,
      "shadow": true,
      "nilness": true,
      "unusedwrite": true,
      "useany": true,
      "fieldalignment": true,
      "unusedresult": true
    }
  },

  // ============================================================
  // SonarLint (per sonarlint-checks.md + extreme-lint-policy.md)
  // ============================================================
  "sonarlint.rules": {
    // Strict thresholds override Sonar defaults — see
    // extreme-lint-policy.md
    "typescript:S3776": { "level": "on" }, // cognitive complexity ≤ 10
    "typescript:S138": { "level": "on" },  // function lines ≤ 80
    "typescript:S107": { "level": "on" },  // function params ≤ 5
    "typescript:S104": { "level": "on" },  // file lines ≤ 500
    "typescript:S134": { "level": "on" },  // nested depth ≤ 3
    "typescript:S1067": { "level": "on" }, // boolean operators ≤ 2
    "typescript:S109": { "level": "on" }   // magic numbers
  },
  "sonarlint.output.showVerboseLogs": false,

  // ============================================================
  // Files (exclude noise, surface signal)
  // ============================================================
  "files.exclude": {
    "**/.git": false,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.coverage": true,
    "**/.terraform": true,
    "**/.serverless": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.turbo": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/go.sum": true,
    "**/Cargo.lock": true
  },

  // ============================================================
  // Terminal
  // ============================================================
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "terminal.integrated.confirmOnKill": "always",
  "terminal.integrated.scrollback": 10000,

  // ============================================================
  // UI / quality of life
  // ============================================================
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "scm.diffDecorationsGutterAction": "diff",

  // ============================================================
  // Diagnostics surface (per no-discards.md + extreme-lint-policy.md)
  // Inline diagnostics — every warning a bug to fix, never to dismiss
  // ============================================================
  // Error Lens — surfaces Sonar / ESLint / tsc / ruff findings inline.
  // Recommended extension: usernamehw.errorlens
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info"],
  "errorLens.gutterIconsEnabled": true,
  "errorLens.followCursor": "allLines",
  "errorLens.fontStyleItalic": false,
  "errorLens.excludeBySource": [],
  "errorLens.delay": 100,

  // Problems panel — severity-first so blockers surface above style
  "problems.sortOrder": "severity",
  "problems.showCurrentInStatus": true,
  "problems.decorations.enabled": true,

  // ============================================================
  // YAML schemas (per yaml/coding-style.md)
  // Auto-validate canonical YAML shapes against published schemas
  // ============================================================
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": [
      ".github/workflows/*.{yml,yaml}"
    ],
    "https://json.schemastore.org/github-action.json": [
      ".github/actions/*/action.{yml,yaml}",
      "action.{yml,yaml}"
    ],
    "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": [
      "docker-compose*.{yml,yaml}",
      "compose*.{yml,yaml}"
    ],
    "https://json.schemastore.org/dependabot-2.0.json": [
      ".github/dependabot.{yml,yaml}"
    ],
    "https://json.schemastore.org/renovate.json": [
      "renovate.json",
      ".renovaterc",
      ".renovaterc.json"
    ],
    "https://json.schemastore.org/pre-commit-config.json": [
      ".pre-commit-config.{yml,yaml}"
    ],
    "kubernetes": [
      "k8s/**/*.{yml,yaml}",
      "kubernetes/**/*.{yml,yaml}",
      "manifests/**/*.{yml,yaml}",
      "helm/**/templates/*.{yml,yaml}"
    ]
  },
  "yaml.validate": true,
  "yaml.format.enable": true,
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.schemaStore.enable": true,

  // ============================================================
  // File associations — surface odd/extensionless files correctly
  // ============================================================
  "files.associations": {
    "*.json5": "jsonc",
    "*.jsonc": "jsonc",
    ".env*": "dotenv",
    "Dockerfile.*": "dockerfile",
    "*.containerfile": "dockerfile",
    "Containerfile": "dockerfile",
    "Makefile.*": "makefile",
    "*.mk": "makefile",
    "*.tfvars": "terraform",
    "*.hcl": "terraform",
    ".gitignore": "ignore",
    ".dockerignore": "ignore",
    ".eslintignore": "ignore",
    ".prettierignore": "ignore",
    "*.code-snippets": "jsonc",
    "*.code-workspace": "jsonc",
    ".sqlfluff": "ini",
    ".luacheckrc": "lua",
    ".rubocop.yml": "yaml",
    ".golangci.yml": "yaml",
    "renovate.json5": "jsonc",
    "*.bats": "shellscript"
  },

  // ============================================================
  // TODO highlighting — TODO/FIXME/XXX BANNED per no-silent-drops.md
  // Recommended extension: gruntfuggly.todo-tree
  // Highlight any introduction in alarming red so reviewer catches it
  // before merge. The rule is to implement OR open a real ticket — not
  // to leave the marker in the code.
  // ============================================================
  "todo-tree.general.tags": ["TODO", "FIXME", "XXX", "BUG", "HACK"],
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "#ffffff",
    "background": "#d70000",
    "icon": "alert",
    "type": "tag-and-comment",
    "iconColour": "#d70000",
    "fontWeight": "bold"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO":  { "foreground": "#ffffff", "background": "#d70000" },
    "FIXME": { "foreground": "#ffffff", "background": "#d70000" },
    "XXX":   { "foreground": "#ffffff", "background": "#d70000" },
    "BUG":   { "foreground": "#ffffff", "background": "#d70000" },
    "HACK":  { "foreground": "#ffffff", "background": "#d70000" }
  },
  "todo-tree.tree.showCountsInTree": true,
  "todo-tree.tree.showBadges": true,
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",

  // ============================================================
  // Spell check (per documentation-requirements.md)
  // Catches typos in user-facing copy + docs + identifiers
  // Recommended extension: streetsidesoftware.code-spell-checker
  // ============================================================
  "cSpell.enabled": true,
  "cSpell.diagnosticLevel": "Information",
  "cSpell.allowCompoundWords": true,
  "cSpell.enableFiletypes": [
    "asciidoc", "go", "javascript", "javascriptreact",
    "json", "jsonc", "markdown", "plaintext", "python",
    "ruby", "rust", "shellscript", "swift", "typescript",
    "typescriptreact", "vue", "yaml"
  ],
  "cSpell.ignorePaths": [
    "node_modules/**",
    "dist/**", "build/**", "coverage/**",
    ".git/**", ".turbo/**", ".next/**", ".nuxt/**",
    "pnpm-lock.yaml", "package-lock.json", "yarn.lock",
    "go.sum", "Cargo.lock", "Gemfile.lock", "poetry.lock"
  ],
  "cSpell.words": [
    // Project-vocabulary placeholder — projects extend via .cspell.json
    "anthropic", "claude", "diátaxis", "diataxis"
  ],

  // ============================================================
  // Claude Code extension (anthropic.claude-code)
  // ============================================================
  "claudeCode.initialPermissionMode": "default",
  "claudeCode.allowDangerouslySkipPermissions": false,

  // ============================================================
  // Codex extension (openai.chatgpt)
  // Model, sandbox, approval and compaction settings belong in Codex config.toml.
  // Hook trust is reviewed separately in Codex; editor settings do not grant it.
  // ============================================================
  "chatgpt.openOnStartup": false,
  "chatgpt.followUpQueueMode": "steer"
}
