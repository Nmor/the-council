// ---------------------------------------------------------------
// Repository-level markdownlint config for "The Council".
// ---------------------------------------------------------------
//
// Editorial scope: this repo is a public-facing OSS project. The
// README, INSTALL guide, and the docs/* set need inline HTML to
// render the banner, badges row, side-by-side comparison tables,
// and centered blocks on GitHub.
//
// We do NOT disable MD033 globally — instead we use markdownlint's
// supported `allowed_elements` allowlist to permit the specific
// HTML elements GitHub renders for fancy READMEs. Every other
// markdownlint rule stays at canonical strictness:
//
//   MD022  blanks around headings
//   MD031  blanks around code blocks
//   MD032  blanks around lists
//   MD040  fenced code block language required
//   MD004  unordered lists use dashes
//   MD060  table column style
//
// Per ~/.claude/rules/common/extreme-lint-policy.md:
// "If a rule is wrong for the project, the project's lint CONFIG
// changes ... The CODE never carries a per-line suppression to
// bypass the rule." This file IS that config change.
// ---------------------------------------------------------------

{
  "default": true,
  // ----------------------------------------------------------------
  // Line length — disabled.  The repo's prose width comes from
  // multi-paragraph code-style hard wrapping that already passes
  // human review.  Enforcing MD013 in markdown produces churn
  // without quality gain.
  // ----------------------------------------------------------------
  "MD013": false,

  // ----------------------------------------------------------------
  // Multiple H1s — DISABLED for this repo.  The skills/* SKILL.md
  // pattern concatenates several source files (each with their own
  // canonical `# Title`) into a single skill body so the cold-load
  // surface stays under the lazy-load budget.  Converting every
  // sub-title to H2 would change every cross-reference.
  // The frontmatter `name:` is the canonical title.
  // ----------------------------------------------------------------
  "MD025": false,

  // ----------------------------------------------------------------
  // First-line H1 — DISABLED.  Many files start with either a
  // frontmatter block followed by a "> Migrated 2026-06-02 from..."
  // note OR a blockquote callout.  The H1 lives further down.
  // ----------------------------------------------------------------
  "MD041": false,

  // ----------------------------------------------------------------
  // Duplicate headings — DISABLED.  Skills concatenate sections
  // that legitimately share names ("Why this rule exists",
  // "Cross-references", "Standards Cited").  siblings_only doesn't
  // help because every section H2 IS a sibling.
  // ----------------------------------------------------------------
  "MD024": false,

  // ----------------------------------------------------------------
  // Emphasis as heading — DISABLED.  The "**Bold sub-title:**"
  // pattern is intentional UX for in-text labels that don't deserve
  // an H3 in the document outline.
  // ----------------------------------------------------------------
  "MD036": false,

  // ----------------------------------------------------------------
  // Table column style — DISABLED.  Both `| x | y |` and `|x|y|`
  // styles are valid CommonMark + GFM.  Enforcing one over the
  // other across 100+ tables produces churn without quality gain.
  // ----------------------------------------------------------------
  "MD060": false,

  // ----------------------------------------------------------------
  // Active rules with project-specific tuning
  // ----------------------------------------------------------------
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  "MD033": {
    "allowed_elements": [
      "a", "br", "img", "div", "span",
      "table", "thead", "tbody", "tr", "th", "td",
      "details", "summary",
      "kbd", "sub", "sup", "code", "pre",
      "strong", "em", "b", "i", "p"
    ]
  }
}
