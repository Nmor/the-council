# ============================================================
# ~/.claude/ .gitignore
# ============================================================
# This file MUST exist before any `git add -A` — see Phase 0 of
# the peppy-painting-parrot rebuild plan.
#
# Strategy: track the *config surface* (rules/, skills/, agents/,
# commands/, hooks/, scripts/, settings*, CLAUDE.md, templates/,
# plans/peppy-painting-parrot.md, etc.) and exclude every auto-
# managed runtime artifact (conversation history, telemetry,
# session locks, caches).
# ============================================================

# --- Per-user secrets / project-token list ---
# `~/.claude/.local/` holds the operator's own per-machine values
# (project-name token list, vault paths, etc.). NEVER committed.
.local/

# --- Heavy auto-managed runtime state (5+ GB total) ---
projects/
sessions/
session-env/
telemetry/
statsig/
file-history/
shell-snapshots/
todos/
ide/
debug/
downloads/
backups/

# --- Auto-fetched caches ---
cache/
mcp-needs-auth-cache.json
stats-cache.json
.last-cleanup

# --- macOS metadata ---
.DS_Store
**/.DS_Store

# --- Per-user shell / history state ---
history.jsonl

# --- Lockfiles, tmp files ---
*.lock
*.tmp
*.swp
*.bak
*.orig

# --- Local secrets / personal config that must never enter git ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.netrc
.vault-token

# --- Plans + audits: per-session narrative + per-user state.
# Per `~/.claude/rules/common/project-scoped-artifacts.md` rule 11,
# these directories MUST always be gitignored AND MUST NOT be
# referenced as repo paths in any checked-in code file. They
# carry rebuild narrative, per-author drafts, workspace names,
# customer / vendor references, learning-event streams, and
# security audit reports that don't belong in shared history.
# Archive workspace-scrubbed institutional knowledge under
# `docs/adr/` (per `adr-template.md`) instead.
plans/
audits/

# --- Python bytecode (improve-prompt.py is committed source) ---
__pycache__/
*.pyc
*.pyo

# --- Editor / IDE locks ---
*.lock-info
.swp

# --- Settings backups (kept out of VCS) ---
settings.json.bak-*
*.bak-council-audit-*

# --- Machine-local MCP config + tool-installed hooks (never in VCS) ---
# Installed per-machine by external tools (e.g. codebase-memory-mcp);
# carry absolute paths / local state, so they must not enter the repo.
.mcp.json
hooks/cbm-*

# --- Per-owner / third-party content (not Council guidance) ---
skills/synced/
skills/.trash/
skills/graphify/
rules/owner-preferences-*.md
node_modules/
